# Copy to apps/api/.env and fill in.
# SAP Business Accelerator Hub sandbox key: https://api.sap.com -> profile -> Settings -> Show API Key
SAP_API_KEY=

# S/4HANA Cloud sandbox, Business Partner API (OData V2)
SAP_BP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER

# OpenAI, for turning questions into query intents.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=

PORT=3001
CORS_ORIGIN=http://localhost:3000
